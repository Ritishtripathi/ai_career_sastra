<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CareerAI — A clearer way to prepare</title>
<meta name="description" content="CareerAI reads your resume like a mentor would, maps your skill gaps against real roles, and helps you rehearse the interview that actually matters.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,650&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FFFCF6;
    --paper-deep:#FFF3E4;
    --ink:#26190F;
    --ink-soft:#5B4B3D;
    --saffron:#FF6A2E;
    --koi:#C6401E;
    --gold:#E3A548;
    --line:#EBDFCC;
    --white:#FFFFFF;
    --shadow: 0 30px 70px rgba(70,38,10,.12);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    font-family:"Inter",sans-serif;
    color:var(--ink);
    background:var(--paper);
    line-height:1.6;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit}
  button{font:inherit;cursor:pointer}
  img,svg{display:block;max-width:100%}
  :focus-visible{outline:2px solid var(--koi);outline-offset:3px;border-radius:4px}

  .container{width:min(1180px,90%);margin:0 auto}

  h1,h2,h3{font-family:"Fraunces",serif;font-weight:560;letter-spacing:-.01em;color:var(--ink)}

  /* ---------- texture ---------- */
  .grain{position:fixed;inset:0;pointer-events:none;opacity:.028;z-index:60;mix-blend-mode:multiply;
    background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}

  /* ---------- nav ---------- */
  .nav{position:sticky;top:0;z-index:40;background:rgba(255,252,246,.86);backdrop-filter:blur(10px);border-bottom:1px solid transparent;transition:border-color .3s}
  .nav.scrolled{border-color:var(--line)}
  .nav-row{height:78px;display:flex;align-items:center;justify-content:space-between}
  .brand{display:flex;align-items:center;gap:11px;font-family:"Fraunces",serif;font-weight:600;font-size:19px;letter-spacing:-.01em}
  .brand-mark{width:34px;height:34px;flex-shrink:0}
  .nav-links{display:flex;gap:34px;font-size:14.5px;color:var(--ink-soft)}
  .nav-links a{position:relative;padding-bottom:3px}
  .nav-links a::after{content:"";position:absolute;left:0;right:100%;bottom:0;height:1px;background:var(--koi);transition:right .28s ease}
  .nav-links a:hover{color:var(--ink)}
  .nav-links a:hover::after{right:0}
  .nav-actions{display:flex;align-items:center;gap:10px}
  .menu-btn{display:none;background:none;border:0;width:38px;height:38px;position:relative}
  .menu-btn span{position:absolute;left:9px;right:9px;height:1.5px;background:var(--ink);transition:.25s}
  .menu-btn span:nth-child(1){top:14px}.menu-btn span:nth-child(2){top:19px}.menu-btn span:nth-child(3){top:24px}
  .menu-btn.open span:nth-child(1){transform:translateY(5px) rotate(45deg)}
  .menu-btn.open span:nth-child(2){opacity:0}
  .menu-btn.open span:nth-child(3){transform:translateY(-5px) rotate(-45deg)}

  .btn{border:0;border-radius:12px;padding:13px 22px;font-weight:600;font-size:14.5px;transition:.25s;display:inline-flex;align-items:center;gap:8px}
  .btn-line{background:transparent;border:1px solid var(--line);color:var(--ink)}
  .btn-line:hover{border-color:var(--ink)}
  .btn-solid{background:var(--ink);color:var(--paper)}
  .btn-solid:hover{background:var(--koi);transform:translateY(-2px);box-shadow:0 14px 26px rgba(198,64,30,.28)}
  .btn-cream{background:var(--paper);color:var(--ink)}
  .btn-cream:hover{background:var(--white);transform:translateY(-2px)}

  /* ---------- mobile nav sheet ---------- */
  .mobile-sheet{position:fixed;inset:78px 0 0 0;background:var(--paper);z-index:39;padding:30px 5%;display:none;flex-direction:column;gap:26px;font-size:20px;font-family:"Fraunces",serif;transform:translateY(-8px);opacity:0;pointer-events:none;transition:.28s}
  .mobile-sheet.open{display:flex;opacity:1;transform:none;pointer-events:auto}
  .mobile-sheet a{border-bottom:1px solid var(--line);padding-bottom:18px}

  /* ---------- hero ---------- */
  .hero{padding:64px 0 40px;display:grid;grid-template-columns:1.08fr .92fr;gap:70px;align-items:center}
  .hero-eyebrow{font-size:14px;color:var(--ink-soft);margin-bottom:20px;max-width:340px}
  h1{font-size:clamp(40px,4.6vw,60px);line-height:1.08;max-width:620px}
  .hero-copy{font-size:17px;color:var(--ink-soft);max-width:480px;margin:24px 0 32px}
  .hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:34px}
  .hero-trust{display:flex;gap:22px;flex-wrap:wrap;font-size:13px;color:var(--ink-soft)}
  .hero-trust span{display:flex;align-items:center;gap:7px}
  .hero-trust i{width:5px;height:5px;border-radius:50%;background:var(--gold);display:inline-block}

  .pond{position:relative;aspect-ratio:1/1;max-width:460px;margin:0 auto}
  .pond-caption{text-align:center;margin-top:18px;font-family:"Fraunces",serif;font-size:14px;font-style:normal;color:var(--ink-soft)}
  .koi-svg{width:100%;height:100%;animation:spin 34s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}
  .koi-svg .fin-detail{animation:none}

  /* ---------- strip ---------- */
  .strip{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:34px 0}
  .strip-row{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
  .strip-item{display:flex;gap:14px;align-items:flex-start}
  .strip-ring{width:30px;height:30px;flex-shrink:0;margin-top:2px}
  .strip-item p{font-size:14.5px;color:var(--ink-soft);max-width:280px}

  /* ---------- section shell ---------- */
  .section{padding:120px 0}
  .section-head{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:end;margin-bottom:56px}
  .section-head h2{font-size:clamp(30px,3.4vw,42px);line-height:1.12}
  .section-head p{color:var(--ink-soft);font-size:15.5px;max-width:400px}

  /* ---------- bento features ---------- */
  .bento{display:grid;grid-template-columns:repeat(6,1fr);gap:16px}
  .card{background:var(--white);border:1px solid var(--line);border-radius:20px;padding:32px;position:relative;overflow:hidden;transition:.3s}
  .card:hover{transform:translateY(-4px);box-shadow:var(--shadow);border-color:#E0CDB4}
  .card.large{grid-column:span 3}
  .card.medium{grid-column:span 3}
  .card.small{grid-column:span 2}
  .card-ring{width:44px;height:44px;margin-bottom:26px}
  .card h3{font-size:19px;margin-bottom:10px;font-weight:560}
  .card p{font-size:14px;color:var(--ink-soft)}
  .card .tag{position:absolute;top:26px;right:28px;font-size:11px;color:var(--koi);border:1px solid #F4D8BF;background:var(--paper-deep);padding:5px 10px;border-radius:99px}

  /* ---------- process ---------- */
  .process{background:var(--ink);border-radius:28px;padding:64px 56px;color:var(--paper)}
  .process .section-head p, .process .section-head{color:var(--paper)}
  .process-head p{color:#C9BAA8;max-width:460px;font-size:15px;margin-top:14px}
  .process-head h2{color:var(--paper)}
  .stream{position:relative;margin-top:58px}
  .stream-line{width:100%;height:2px;display:block;margin-bottom:0}
  .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:-1px}
  .step{padding-top:26px;position:relative}
  .step::before{content:"";position:absolute;top:0;left:0;width:9px;height:9px;border-radius:50%;background:var(--gold);transform:translate(-50%,-50%)}
  .step .num{font-family:"Fraunces",serif;font-size:13px;color:var(--gold);margin-bottom:10px;display:block}
  .step h3{color:var(--paper);font-size:18px;margin-bottom:8px}
  .step p{font-size:13.5px;color:#B7A794}

  /* ---------- deep dive ---------- */
  .dive{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
  .dive + .dive{margin-top:130px}
  .dive.reverse .dive-copy{order:2}
  .dive.reverse .dive-visual{order:1}
  .dive-kicker{font-size:13px;color:var(--koi);margin-bottom:14px}
  .dive-copy h2{font-size:clamp(26px,2.8vw,34px);margin-bottom:18px;line-height:1.16}
  .dive-copy p{color:var(--ink-soft);font-size:15.5px;margin-bottom:22px;max-width:440px}
  .dive-list{display:flex;flex-direction:column;gap:12px}
  .dive-list li{list-style:none;display:flex;gap:11px;font-size:14.5px;color:var(--ink)}
  .dive-list svg{flex-shrink:0;margin-top:3px}

  .mock{background:var(--white);border:1px solid var(--line);border-radius:22px;padding:22px;box-shadow:var(--shadow)}
  .mock-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
  .mock-dot-row{display:flex;gap:6px}
  .mock-dot{width:8px;height:8px;border-radius:50%;background:var(--line)}
  .mock-title{font-size:12.5px;color:var(--ink-soft)}

  .score-panel{background:var(--ink);border-radius:16px;padding:22px;display:flex;justify-content:space-between;align-items:center;color:var(--paper);margin-bottom:14px}
  .score-panel .num-big{font-family:"Fraunces",serif;font-size:46px;line-height:1}
  .score-panel .num-big b{font-size:16px;color:#C9BAA8;font-weight:500}
  .score-panel .label{font-size:12px;color:#C9BAA8;margin-bottom:6px}
  .enso-ring{width:70px;height:70px}

  .row-mini{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .mini-box{border:1px solid var(--line);border-radius:14px;padding:15px}
  .mini-box h4{font-size:12.5px;margin-bottom:8px;color:var(--ink-soft);font-weight:600}
  .skill-bar{height:6px;border-radius:4px;background:var(--paper-deep);overflow:hidden;margin-top:8px}
  .skill-bar i{display:block;height:100%;background:linear-gradient(90deg,var(--gold),var(--saffron));border-radius:4px}

  .chat-mock .line{display:flex;gap:10px;margin-bottom:12px;font-size:13px}
  .chat-mock .avatar{width:26px;height:26px;border-radius:50%;flex-shrink:0}
  .chat-mock .bubble{background:var(--paper-deep);border-radius:12px;padding:10px 13px;color:var(--ink-soft);max-width:88%}
  .chat-mock .bubble.you{background:var(--ink);color:var(--paper)}
  .chat-mock .you-row{justify-content:flex-end}

  /* ---------- quote ---------- */
  .quote{padding:120px 0;text-align:center;position:relative}
  .quote-mark{width:46px;height:46px;margin:0 auto 30px}
  blockquote{font-family:"Fraunces",serif;font-weight:500;font-size:clamp(26px,3.2vw,40px);line-height:1.28;max-width:820px;margin:0 auto;color:var(--ink)}
  .quote cite{display:block;margin-top:26px;font-size:13px;color:var(--ink-soft);font-style:normal}

  /* ---------- cta ---------- */
  .cta{background:linear-gradient(125deg,#FF7A3D,var(--koi));border-radius:28px;padding:64px;color:var(--white);display:flex;justify-content:space-between;align-items:center;gap:40px;position:relative;overflow:hidden}
  .cta::before{content:"";position:absolute;width:1px;height:1px;box-shadow:0 0 0 1px rgba(255,255,255,.18);border-radius:50%;width:340px;height:340px;right:-90px;top:-140px}
  .cta::after{content:"";position:absolute;width:210px;height:210px;box-shadow:0 0 0 1px rgba(255,255,255,.28);border-radius:50%;right:-10px;bottom:-120px}
  .cta h2{color:var(--white);font-size:clamp(28px,3vw,38px);max-width:520px}
  .cta p{color:#FFE2CC;margin-top:12px;font-size:14.5px;max-width:440px}
  .cta-right{position:relative;z-index:1;flex-shrink:0}

  /* ---------- footer ---------- */
  footer{padding:60px 0 40px;display:flex;justify-content:space-between;align-items:flex-end;gap:30px;flex-wrap:wrap;border-top:1px solid var(--line)}
  .footer-brand{display:flex;align-items:center;gap:10px;font-family:"Fraunces",serif;font-weight:600;font-size:17px;margin-bottom:8px}
  .footer-brand svg{width:26px;height:26px}
  footer .tagline{font-size:13px;color:var(--ink-soft);max-width:280px}
  .footer-links{display:flex;gap:26px;font-size:13px;color:var(--ink-soft)}
  .footer-meta{font-size:12.5px;color:var(--ink-soft)}

  /* ---------- toast ---------- */
  .toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,16px);background:var(--ink);color:var(--paper);padding:13px 20px;border-radius:12px;font-size:13.5px;opacity:0;pointer-events:none;transition:.3s;z-index:100}
  .toast.on{opacity:1;transform:translate(-50%,0)}

  @media(prefers-reduced-motion: reduce){
    html{scroll-behavior:auto}
    .koi-svg{animation:none}
  }

  /* ---------- responsive ---------- */
  @media(max-width:980px){
    .hero{grid-template-columns:1fr;gap:50px;text-align:left}
    .pond{max-width:340px}
    .dive{grid-template-columns:1fr}
    .dive.reverse .dive-copy{order:1}
    .dive.reverse .dive-visual{order:2}
    .process{padding:44px 30px}
    .steps{grid-template-columns:1fr 1fr;row-gap:36px}
  }
  @media(max-width:760px){
    .nav-links{display:none}
    .menu-btn{display:block}
    .strip-row{grid-template-columns:1fr;gap:20px}
    .section{padding:80px 0}
    .section-head{grid-template-columns:1fr}
    .bento{grid-template-columns:1fr 1fr}
    .card.large,.card.medium{grid-column:span 2}
    .card.small{grid-column:span 1}
    .steps{grid-template-columns:1fr}
    .cta{flex-direction:column;text-align:left;padding:44px 30px}
    .dive-copy p{max-width:none}
    footer{flex-direction:column;align-items:flex-start}
  }
  @media(max-width:480px){
    .bento{grid-template-columns:1fr}
    .card.large,.card.medium,.card.small{grid-column:span 1}
  }
</style>
</head>
<body>
<div class="grain"></div>

<header class="nav" id="nav">
  <div class="container nav-row">
    <a class="brand" href="#top">
      <svg class="brand-mark" viewBox="0 0 40 40" fill="none">
        <circle cx="20" cy="20" r="18" stroke="var(--ink)" stroke-width="1.3" opacity=".35"/>
        <circle cx="20" cy="20" r="12" fill="var(--paper-deep)"/>
        <path d="M20,8 A12,12 0 0,1 20,32 A6,6 0 0,1 20,20 A6,6 0 0,0 20,8 Z" fill="var(--saffron)"/>
        <circle cx="20" cy="12" r="1.4" fill="var(--paper)"/>
